# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-this-root-password
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=change-this-app-password
MONGO_URI=mongodb://appuser:change-this-app-password@mongo:27017/ai-agent?authSource=ai-agent
MONGO_PORT=27017

# Auth (required)
JWT_SECRET=change-this-to-a-secure-random-string

# LLM Providers (optional)
GROQ_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Worker (optional tuning)
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=1
WORKER_MAX_ATTEMPTS=3

# Optional host port overrides
MONGO_PORT=27017
BACKEND_PORT=5000
FRONTEND_PORT=3000
NGINX_PORT=80
REDIS_PORT=6379

# Cache (optional — dashboard caching degrades gracefully without Redis)
REDIS_URL=redis://localhost:6379
DASHBOARD_CACHE_TTL_MS=30000

# Worker → backend internal broadcasts. In Docker, the worker container
# must reach the backend via the Docker service hostname `backend`, NOT
# localhost (which inside the worker container refers to itself). The
# docker-compose.yml worker service sets this automatically; only set it
# here if you run the worker outside of docker-compose.
#   Docker:  http://backend:5000
#   Local:   http://localhost:5000  (the runner falls back to this when
#                                    BACKEND_INTERNAL_URL is unset)
# BACKEND_INTERNAL_URL=http://backend:5000

# Frontend → backend API and Socket.IO are routed SAME-ORIGIN by the
# Next.js server (see `frontend/next.config.js` and
# `infra/docker-compose.yml`). The browser sees `/api/*` and
# `/socket.io/*`; the Next.js server proxies them to the backend using
# a SERVER-ONLY `BACKEND_INTERNAL_URL` (set on the `frontend` service
# to `http://backend:5000`). Do NOT use `NEXT_PUBLIC_API_URL` for the
# standard Docker deploy — the browser cannot resolve Docker-internal
# hostnames. To deploy behind a custom domain, simply point the domain
# at the frontend port (3000) and the rewrites take care of the rest.
# If you must reach the backend from a different origin (e.g. a
# standalone frontend hosted on a different machine), pass
# `NEXT_PUBLIC_API_URL=https://api.example.com` as a build arg when
# running `docker compose build`.

